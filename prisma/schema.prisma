generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  username      String
  usernameLower String   @unique
  email         String   @unique
  firstName     String?  @map("first_name")
  lastName      String?  @map("last_name")
  password      String
  role          UserRole @default(REGULAR)
  avatar        String?
}

enum UserRole {
  REGULAR
  ADMIN
}
